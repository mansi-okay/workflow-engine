generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  USER_LOGGED_OUT_ALL

  SESSION_REFRESHED
  SESSION_REVOKED

  EMAIL_VERIFIED
  VERIFICATION_EMAIL_RESENT

  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED

  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_DELETED

  INVITATION_SENT
  INVITATION_ACCEPTED
  INVITATION_REVOKED

  MEMBER_ROLE_UPDATED
  MEMBER_REMOVED
  MEMBER_LEFT
  MEMBER_OWNERSHIP_TRANSFERRED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum IdempotencyOperation {
  CREATE_ORGANIZATION
  CREATE_INVITATION
  ACCEPT_INVITATION
  TRANSFER_OWNERSHIP
  FORGOT_PASSWORD
  RESET_PASSWORD
  VERIFY_EMAIL
  RESEND_VERIFICATION_EMAIL
}

enum OutboxEventType {
  SEND_INVITATION_EMAIL
  SEND_VERIFICATION_EMAIL
  SEND_PASSWORD_RESET_EMAIL
  SEND_PASSWORD_RESET_SUCCESS_EMAIL
  SEND_EMAIL_VERIFICATION_SUCCESS_EMAIL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id String @id @default(cuid())
  name String

  // Email is unique only among active users.
  // Soft-deleted users retain their email, but the email can be reused
  // when a new account is registered. 
  email String
  
  hashedPassword String
  isEmailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  sessions Session[]
  verificationTokens VerificationToken[]
  memberships Membership[]
  invitations Invitation[] @relation("InvitationsSent")
  auditLogs AuditLog[]
  idempotencyKeys IdempotencyKey[]
}

model Session {
  id String @id @default(cuid())

  userId String
  user User @relation(fields: [userId],references: [id], onDelete: Cascade)

  hashedRefreshToken String

  ipAddress String?
  userAgent String?
  deviceName String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  lastUsedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken{
  id String @id @default(cuid())

  userId String 
  user User @relation(fields: [userId],references: [id], onDelete: Cascade)

  hashedToken String @unique
  type VerificationTokenType

  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Organization {
  id String @id @default(cuid())
  name String

  // Slugs remain permanently reserved after soft deletion.
  // Prevents old organization URLs from being reused.
  slug String @unique
  
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  invitations Invitation[]
}

model Membership {
  id String @id @default(cuid())
  
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  role Role

  joinedAt DateTime @default(now())

  @@unique([userId, organizationId])

  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id String @id @default(cuid())
  email String
  hashedToken String @unique

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy User @relation("InvitationsSent",fields: [invitedById], references: [id])

  role Role

  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  acceptedAt DateTime?

  @@index([email])
  @@index([invitedById])
  @@index([organizationId])
  @@index([organizationId,email])
}

model AuditLog {
  id String @id @default(cuid())
  action AuditAction

  userId String?
  user User? @relation(fields: [userId],references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?
  metadata Json?

  createdAt DateTime @default(now())
  
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

model IdempotencyKey {
  id String @id @default(cuid())
  key String

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  requestHash String
  operation IdempotencyOperation
  status IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody Json?

  createdAt DateTime @default(now())
  expiresAt DateTime 

  @@unique([userId, key, operation])
  @@index([expiresAt])
}

model OutboxEvent {
  id String @id @default(cuid())
  type OutboxEventType
  payload Json
  status OutboxStatus @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
}