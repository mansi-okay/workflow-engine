generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGGED_IN
  USER_LOGGED_OUT
  USER_LOGGED_OUT_ALL

  SESSION_REFRESHED
  SESSION_REVOKED

  EMAIL_VERIFIED
  VERIFICATION_EMAIL_RESENT

  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED

  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_DELETED

  INVITATION_SENT
  INVITATION_ACCEPTED
  INVITATION_REVOKED

  MEMBER_ROLE_UPDATED
  MEMBER_REMOVED
  MEMBER_LEFT
  MEMBER_OWNERSHIP_TRANSFERRED

  WORKFLOW_CREATED
  WORKFLOW_UPDATED
  WORKFLOW_DELETED

  WORKFLOW_GRAPH_UPDATED
  WORKFLOW_DRAFT_CREATED
  WORKFLOW_VERSION_PUBLISHED
  WORKFLOW_VERSION_ROLLED_BACK

  WORKFLOW_EXECUTION_REQUESTED
  WORKFLOW_EXECUTION_STARTED
  WORKFLOW_EXECUTION_SUCCEEDED
  WORKFLOW_EXECUTION_FAILED
  WORKFLOW_EXECUTION_CANCEL_REQUESTED
  WORKFLOW_EXECUTION_CANCELLED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum IdempotencyOperation {
  CREATE_ORGANIZATION

  CREATE_INVITATION
  ACCEPT_INVITATION

  TRANSFER_OWNERSHIP

  FORGOT_PASSWORD
  RESET_PASSWORD

  VERIFY_EMAIL
  RESEND_VERIFICATION_EMAIL

  CREATE_WORKFLOW
  UPDATE_WORKFLOW
  DELETE_WORKFLOW

  UPDATE_WORKFLOW_GRAPH
  CREATE_WORKFLOW_DRAFT
  PUBLISH_WORKFLOW_VERSION
  ROLLBACK_WORKFLOW_VERSION

  RUN_WORKFLOW
}

enum OutboxEventType {
  SEND_INVITATION_EMAIL
  SEND_VERIFICATION_EMAIL
  SEND_PASSWORD_RESET_EMAIL
  SEND_PASSWORD_RESET_SUCCESS_EMAIL
  SEND_EMAIL_VERIFICATION_SUCCESS_EMAIL
  WORKFLOW_EXECUTION_REQUESTED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  CANCEL_REQUESTED
  SUCCESS
  FAILED
  CANCELLED
}

enum NodeExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  CANCELLED
}

enum TriggerType {
  MANUAL
  WEBHOOK
}

model User {
  id   String @id @default(cuid())
  name String

  // Email is unique only among active users.
  // Soft-deleted users retain their email, but the email can be reused
  // when a new account is registered. 
  email String

  hashedPassword  String
  isEmailVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions                  Session[]
  verificationTokens        VerificationToken[]
  memberships               Membership[]
  invitations               Invitation[]        @relation("InvitationsSent")
  auditLogs                 AuditLog[]
  idempotencyKeys           IdempotencyKey[]
  workflows                 Workflow[]          @relation("WorkflowCreatedBy")
  workflowVersionsCreated   WorkflowVersion[]   @relation("WorkflowVersionCreatedBy")
  workflowVersionsPublished WorkflowVersion[]   @relation("WorkflowVersionPublishedBy")
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hashedRefreshToken String

  ipAddress  String?
  userAgent  String?
  deviceName String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hashedToken String                @unique
  type        VerificationTokenType

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Organization {
  id   String @id @default(cuid())
  name String

  // Slugs remain permanently reserved after soft deletion.
  // Prevents old organization URLs from being reused.
  slug String @unique

  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  invitations Invitation[]
  workflows   Workflow[]
}

model Membership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role Role

  joinedAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id          String @id @default(cuid())
  email       String
  hashedToken String @unique

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitationsSent", fields: [invitedById], references: [id])

  role Role

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  acceptedAt DateTime?

  @@index([email])
  @@index([invitedById])
  @@index([organizationId])
  @@index([organizationId, email])
}

model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

model IdempotencyKey {
  id  String @id @default(cuid())
  key String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  requestHash    String
  operation      IdempotencyOperation
  status         IdempotencyStatus    @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([userId, key, operation])
  @@index([expiresAt])
}

model OutboxEvent {
  id          String          @id @default(cuid())
  type        OutboxEventType
  payload     Json
  status      OutboxStatus    @default(PENDING)
  attempts    Int             @default(0)
  availableAt DateTime        @default(now())
  processedAt DateTime?
  claimedAt DateTime? // for recovering stale PROCESSING
  // Prevents differnt workers from changing the outbox event state but not exactly-once execution
  claimToken String? 
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, availableAt])
  @@index([status, claimedAt])
}

model Workflow {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  currentPublishedVersionId String?
  currentPublishedVersion   WorkflowVersion? @relation("PublishedVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)

  currentDraftVersionId String?
  currentDraftVersion   WorkflowVersion? @relation("DraftVersion", fields: [currentDraftVersionId], references: [id], onDelete: SetNull)

  createdBy     String?
  createdByUser User?   @relation("WorkflowCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workflowVersions WorkflowVersion[]
  executions Execution[]

  @@index([organizationId])
}

model WorkflowVersion {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  versionNumber Int
  revision Int @default(1)
  status        WorkflowVersionStatus

  createdBy     String?
  createdByUser User?   @relation("WorkflowVersionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  publishedBy     String?
  publishedByUser User?   @relation("WorkflowVersionPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)

  publishedByWorkflow Workflow[] @relation("PublishedVersion")
  draftForWorkflow    Workflow[] @relation("DraftVersion")
  nodes               Node[]
  edges               Edge[]
  executions Execution[]
  nodeExecutions NodeExecution[]

  @@unique([workflowId, versionNumber])
  @@unique([id, workflowId])
}

model Node {
  id String @id @default(cuid())

  workflowVersionId String
  version           WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

  nodeKey  String
  type     String
  config   Json
  position Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outgoingEdges Edge[] @relation("SourceNode")
  incomingEdges Edge[] @relation("TargetNode")
  nodeExecutions NodeExecution[]

  @@unique([workflowVersionId, nodeKey])
  @@unique([id, workflowVersionId])
}

model Edge {
  id String @id @default(cuid())

  workflowVersionId String
  version           WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

  sourceNodeId String
  sourceNode   Node   @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)

  targetNodeId String
  targetNode   Node   @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workflowVersionId, sourceNodeId, targetNodeId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model Execution {
  id String @id @default(cuid())

  workflowId String
  workflow Workflow @relation(fields:[workflowId], references: [id], onDelete: Restrict)

  workflowVersionId String
  workflowVersion WorkflowVersion @relation(fields:[workflowVersionId, workflowId], references: [id, workflowId], onDelete: Restrict)

  status ExecutionStatus @default(QUEUED)
  triggerType TriggerType
  startedAt DateTime?
  completedAt DateTime?
  input Json?
  error Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodeExecutions NodeExecution[]

  @@unique([id, workflowVersionId])
  @@index([workflowVersionId])
  @@index([status])
  @@index([createdAt])
  @@index([workflowId, createdAt])
  @@index([status, createdAt])
}

model NodeExecution {
  id String @id @default(cuid())

  executionId String
  execution Execution @relation(fields:[executionId, workflowVersionId], references: [id, workflowVersionId], onDelete: Restrict)

  nodeId String
  node Node @relation(fields: [nodeId, workflowVersionId], references: [id, workflowVersionId], onDelete: Restrict)

  workflowVersionId String
  workflowVersion WorkflowVersion @relation(fields:[workflowVersionId], references: [id], onDelete: Restrict)

  status NodeExecutionStatus @default(PENDING)
  startedAt DateTime?
  completedAt DateTime?
  input Json?
  output Json?
  error Json?
  attempt Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([executionId, nodeId, attempt])
  @@index([executionId])
  @@index([nodeId])
  @@index([status])
  @@index([createdAt])
}